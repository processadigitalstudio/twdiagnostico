rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // SOLO la administradora (UID del usuario admin en Firebase Authentication).
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'UIsTtqPwumUidDNfbvCQqbCUpbx1';
    }

    function groupOpen(gid) {
      return get(/databases/$(database)/documents/exam_groups/$(gid)).data.status == 'open';
    }

    // Sesión de examen (grupo con contraseña compartida). Su id es el hash de la contraseña: solo se
    // encuentra sabiendo la contraseña (no se puede listar). La admin la abre y la cierra.
    match /exam_groups/{gid} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // Participante = cédula dentro de una sesión. Solo se puede registrar mientras la sesión está abierta.
    match /participants/{pid} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create: if request.resource.data.status == 'registered'
                    && pid == request.resource.data.groupId + '_' + request.resource.data.cedula
                    && groupOpen(request.resource.data.groupId);
      allow update: if isAdmin() || (
        resource.data.status != 'completed' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedAt']) &&
        request.resource.data.status in ['in_progress', 'completed']
      );
    }

    // Intentos. Solo la admin los lee. El estudiante crea el suyo (con la sesión abierta) y lo actualiza mientras esté en curso.
    match /sessions/{id} {
      allow read, delete: if isAdmin();
      allow create: if request.resource.data.status == 'in_progress'
                    && groupOpen(request.resource.data.groupId)
                    && exists(/databases/$(database)/documents/participants/$(request.resource.data.participantId));
      allow update: if isAdmin() || (
        resource.data.status == 'in_progress' &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['username', 'name', 'email', 'institution', 'groupId', 'groupName', 'participantId', 'itemIds', 'bankVersion', 'resultDelivery', 'startedAt']) &&
        request.resource.data.status in ['in_progress', 'completed']
      );
    }

    // Resultado publicado por la admin; el estudiante lo lee con el id (aleatorio) de su intento.
    match /results/{id} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // Clave de respuestas: solo admin.
    match /answer_key/{d} {
      allow read, write: if isAdmin();
    }

    // ---- Panel Bookmark (jueces) ----
    match /judge_codes/{u} {
      allow get: if true;
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }
    match /bookmark_order/{d} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /bookmark_judgments/{d} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
