{
  "hosting": {
    "public": ".",
    "cleanUrls": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      ".git/**",
      "**/.git/**",
      ".firebase/**",
      "apps-script/**",
      "**/node_modules/**",
      "answer_key_PRIVADO_NO_SUBIR.json",
      "serviceAccountKey.json",
      "scripts/**",
      "README.md",
      "firestore.rules"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|json|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "audio/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "img/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      }
    ],
    "site": "tweetaligtest",
    "redirects": [
      {
        "source": "/eam/",
        "destination": "/eam",
        "type": 301
      },
      {
        "source": "/tweetalig/",
        "destination": "/tweetalig",
        "type": 301
      },
      {
        "source": "/unitecnar/",
        "destination": "/unitecnar",
        "type": 301
      },
      {
        "source": "/uniajs/",
        "destination": "/uniajs",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/eam",
        "destination": "/index.html"
      },
      {
        "source": "/tweetalig",
        "destination": "/index.html"
      },
      {
        "source": "/unitecnar",
        "destination": "/index.html"
      },
      {
        "source": "/uniajs",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
